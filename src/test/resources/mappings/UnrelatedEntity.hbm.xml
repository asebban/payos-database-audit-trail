<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd" [
        <!ATTLIST hibernate-mapping xmlns CDATA #REQUIRED>
]>
<hibernate-mapping xmlns="http://www.hibernate.org/schema/hibernate-mapping" package="com.example">
    <!--
        A tenant's own, unrelated business entity — used only to simulate a real deployment's
        database-service.mapping-files, which lists the tenant's own entities, never a plugin's
        infrastructure table (PayosAuditEventTest's "mapping-files forgotten" regression test).
    -->
    <class entity-name="UnrelatedEntity" table="UNRELATED_ENTITY" dynamic-insert="true" dynamic-update="true">
        <id name="id" type="long" column="ID">
            <generator class="identity"/>
        </id>
        <property name="name" type="string" column="NAME"/>
    </class>
</hibernate-mapping>
